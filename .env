# Application
APP_ENV=production
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://user:password@db:5432/default?sslmode=disable
POSTGRES_VERSION=18
DEV_DB_PORT=5432

# PostgreSQL Credentials
POSTGRES_DB=default
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Cache (Dragonfly/Redis)
CACHE_URL=dragonfly:6379
CACHE_PORT=6379
